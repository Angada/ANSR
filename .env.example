# Copy to .env and fill. .env is gitignored.

# --- Local dev DB (docker compose) -------------------------------------------
PGHOST=localhost
PGPORT=5433
PGDATABASE=qansr
PGUSER=qansr
PGPASSWORD=qansr

PORT=4100

# --- Prod / staging (Supabase, Mumbai) ---------------------------------------
# Set DATABASE_URL → app uses it instead of PG* above. PGSSL=1 for Supabase.
DATABASE_URL=
PGSSL=

# Supabase Storage (doc/excel persistence). When both set, originals + md
# extracts go to the bucket instead of local disk (required on Cloud Run).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=docs

# AES-256-GCM secret for provider-key encryption at rest (64 hex chars).
# REQUIRED in prod (else keys can't survive restarts). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# Soft login (prototype gate)
QANSR_USER=vik
QANSR_PW=thedik

# --- Provider keys (prefer the admin panel / Secret Manager in prod) ---------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
